# Copy to `.env.local` (ignored by git). Names only: values never enter the
# repository. See docs/security.md section 2.

# The Supabase project URL. Configuration, not a secret, and not committed.
VITE_SUPABASE_URL=
# The project's anon (publishable) key. Ships in the bundle by design; RLS is
# the protection. Never the service_role key, which is private material.
VITE_SUPABASE_ANON_KEY=
