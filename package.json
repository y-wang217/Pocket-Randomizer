{
  "name": "gymrun",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GYMRUN — a browser-based seeded Pokemon roguelike.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run lint && tsc --noEmit && vitest run && npm run test:trim-strict",
    "test:trim-strict": "GYMRUN_TRIM_STRICT=1 vitest run",
    "sim": "vite-node scripts/sim.ts",
    "gen:pools": "vite-node scripts/gen-pools.ts",
    "content-hash": "vite-node scripts/content-hash.ts",
    "measure": "npm run build && node scripts/measure-bundle.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@pkmn/img": "^0.3.4",
    "@pkmn/protocol": "^0.7.3",
    "@pkmn/sim": "^0.10.11",
    "@pkmn/view": "^0.7.3",
    "@smogon/calc": "^0.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.4",
    "eslint": "^9.39.1",
    "jsdom": "^28.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.2",
    "vite": "^7.1.14",
    "vitest": "^3.2.4"
  }
}
