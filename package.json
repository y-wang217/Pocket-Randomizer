{
  "name": "gymrun",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GYMRUN — a browser-based seeded Pokemon roguelike. Stage 0.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
